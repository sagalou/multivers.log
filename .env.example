# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne jamais commiter le fichier .env (voir .gitignore).

# Clé API Gemini
GEMINI_API_KEY=

# Modèle Gemini utilisé (ex: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Chemin de la base SQLite locale
DATABASE_PATH=./data/multivers.db

# Dossier de stockage des documents uploadés
UPLOAD_DIR=./data/uploads

# Chemin vers le binaire Tesseract (si non trouvé automatiquement dans le PATH)
TESSERACT_CMD=

# Port du serveur FastAPI (optionnel, défaut 8000)
PORT=8000
